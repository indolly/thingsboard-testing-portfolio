# ThingsBoard 服务地址。末尾不要加 /。
TB_BASE_URL=http://127.0.0.1:9091

# 租户管理员账号。真实账号和密码只填写到本地 .env，不要提交到 Git。
TB_TENANT_USERNAME=
TB_TENANT_PASSWORD=

# 设备模块测试数据，不是秘密。
TB_DEVICE_NAME=QA_TEMP_DEVICE_001
TB_DEVICE_PROFILE_NAME=QA_TEMPERATURE_PROFILE
TB_DEVICE_TOKEN=

# 告警模块测试数据，不是秘密。
TB_ALARM_TYPE=High Temperature
TB_ALARM_SEVERITY=MAJOR
TB_ALARM_TRIGGER_TEMPERATURE=80
TB_ALARM_RECOVERY_TEMPERATURE=0
TB_ALARM_WAIT_SECONDS=30

# 资产与关系模块测试数据，不是秘密。
TB_ASSET_NAME=QA_FACTORY_001

# 客户与权限模块。本地密码必须只保存在 local JSON 或 .env。
TB_CUSTOMER_TITLE=QA_CUSTOMER_001
TB_CUSTOMER_USERNAME=qa.customer.001@example.com
TB_CUSTOMER_PASSWORD=

# 单次 HTTP 请求超时时间（秒）。
TB_REQUEST_TIMEOUT=10

