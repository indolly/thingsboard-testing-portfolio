# ThingsBoard 页面地址，末尾不要加 /。
TB_BASE_URL=http://127.0.0.1:9091

# 真实账号和密码只放在本地 .env 或 Jenkins Credentials 中。
TB_TENANT_USERNAME=
TB_TENANT_PASSWORD=
TB_CUSTOMER_USERNAME=
TB_CUSTOMER_PASSWORD=

# 设备页面搜索使用的测试数据。
TB_DEVICE_NAME=QA_TEMP_DEVICE_001

# chrome 或 edge。
UI_BROWSER=chrome

# 本地调试可以改为 false；Jenkins 中建议保持 true。
UI_HEADLESS=true
UI_TIMEOUT=15
